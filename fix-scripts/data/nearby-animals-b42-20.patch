+local function isFiniteNumber(value)
+    return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
+end
+
+local function isUsableAnimal(animal)
+    if not animal or not instanceof(animal, "IsoAnimal") then
+        return false
+    end
+
+    local success, exists = pcall(function()
+        return animal:isExistInTheWorld() or animal:getHutch() or animal:getVehicle()
+    end)
+    return success and exists and true or false
+end
+
+local function isLiveAnimal(animal)
+    if not isUsableAnimal(animal) then
+        return false
+    end
+
+    local success, health = pcall(function()
+        return animal:getHealth()
+    end)
+    return success and type(health) == "number" and health > 0
+end
