# check-mod-updates.py
# Copy to .env and replace every placeholder.
# Steam Workshop IDs, separated by semicolons.
PZ_MOD_IDS=1234567890;2345678901;3456789012
PZ_SERVER_DIR=/absolute/path/to/project-zomboid
PZ_LOCK_FILE=/tmp/pz-mod-check.lock
PZ_CONTAINER=game-project-zomboid
PZ_LOCAL_FIXES=/absolute/path/to/project-zomboid/apply-local-fixes.py
PZ_RCON_PORT=27015
PZ_RCON_BIN=/usr/local/bin/rcon
RCON_PASSWORD=replace-with-the-server-rcon-password
PZ_SERVER_READY_TIMEOUT=1200
PZ_SERVER_READY_POLL=15
PZ_SERVER_STABILITY_SECONDS=90
PZ_SERVER_STABILITY_POLL=15
PZ_PROJECT_NAME=project-zomboid
PZ_MAX_START_ATTEMPTS=2
